{
  "name": "ai-coding-monitor",
  "version": "1.0.0",
  "description": "A local macOS app for switching between your favorite web pages",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac dir"
  },
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "build": {
    "appId": "com.local.aicodingmonitor",
    "productName": "AI Coding Monitor",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "target": "dir"
    }
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  }
}
